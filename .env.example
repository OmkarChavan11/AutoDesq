# Production RDS: READ-ONLY user. AutoDesq never writes here.
RDS_URL=postgresql+psycopg://readonly_user:password@your-rds-host:5432/inrbonds
# Test DB: holds bond_intelligence (WhatsApp) and AutoDesq's own tables (autodesq_*)
TEST_DB_URL=postgresql+psycopg://user:password@your-test-host:5432/testdb

# LLM for reading replies: none | ollama | gemini | anthropic
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Gemini: key from Google AI Studio. Free tier = Google may use the data; use a billed project for real client replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# INRBonds' own cpty_id(s), excluded from dealer ranking (comma separated)
OWN_CPTY_IDS=INRBONDS
# Who to rank and bid to: all = every counterparty (default), list = config.DEALERS / DEALER_CPTY_IDS only
DEALER_SCOPE=all
# With DEALER_SCOPE=all, leave out counterparties flagged is_client
EXCLUDE_CLIENTS=off
# Optional fixed list of cpty_ids (comma-separated); overrides DEALER_SCOPE
DEALER_CPTY_IDS=

# Units of nse/bse_trade_data.volume: auto, or 1 = crore, 0.01 = lakh, 0.0000001 = rupees
EXCHANGE_VOLUME_TO_CR=auto

# Exchange trades below this size (Rs crore) are treated as retail and ignored for liquidity and fair YTM
MIN_TRADE_CR=0.25
# WhatsApp table on the test DB (schema.table if not in public)
WA_TABLE=bond_intelligence
# Prototype: add labelled dummy WhatsApp rows on top of the real data (off for real use)
WA_DUMMY=on
# Let dummy WhatsApp offers set the markup/bid level (keep off: bids should rest on real offers)
WA_DUMMY_SETS_MARKUP=off
# AI engines: auto = use trained LightGBM models from ./models if present
MARKUP_ENGINE=optimise
# lowest acceptable chance that at least one of the top 5 confirms
MIN_FILL_CHANCE=0.6
RANKING_ENGINE=auto
# Counterparties never ranked, bid to or used to train the ranking (comma-separated cpty_ids)
EXCLUDE_CPTY_IDS=SAALTD
# ...and all counterparties whose name contains any of these words
EXCLUDE_NAMES=PATERSON,SUNDARAM
